# Answer generation and table summarisation (Groq)
GROQ_API_KEY=

# Figure summarisation (Google Gemini, vision)
GOOGLE_API_KEY=

# Optional model overrides. Groq retires model ids periodically; check
# https://console.groq.com/docs/models if answers start returning 404.
# ANSWER_MODEL=openai/gpt-oss-120b
# VISION_MODEL=gemini-2.5-flash

# Optional: comma-separated origins allowed to call the API.
# ALLOWED_ORIGINS=http://localhost:3000

# ---------------------------------------------------------------------------
# Public-deployment guardrails.
#
# The defaults suit a deployed instance where visitors spend YOUR API quota.
# Running it privately for yourself? Raise all three.
# ---------------------------------------------------------------------------

# Largest upload accepted. Long documents are the expensive ones.
# MAX_UPLOAD_MB=10

# Figures summarised per document. Each one is a paid vision call.
# MAX_FIGURES_PER_DOC=40

# Documents one visitor may index per hour. 0 disables the limit.
# UPLOADS_PER_HOUR=10
